[Unit]
Description=AstroDashaCare FastAPI Backend Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/astrodashacare/backend
ExecStart=/var/www/astrodashacare/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment="PATH=/var/www/astrodashacare/backend/venv/bin"
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target

